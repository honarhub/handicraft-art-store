datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  phoneNumber   String?   @unique // اضافه شده برای ورود با پیامک در آینده
  password      String?   // برای ورود موقت با ایمیل و رمز عبور
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  artistProfile ArtistProfile?
  orders        Order[]
  certificates  ProductCertificate[] // مدارک مالکیت محصولات خریداری شده
}

enum Role {
  USER
  ARTIST
  ADMIN
}

model ArtistProfile {
  id          String   @id @default(cuid())
  displayId   Int      @default(autoincrement()) @unique
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio         String?
  portfolioUrl String?
  isActive    Boolean  @default(true)
  isDeleted   Boolean  @default(false) // حذف نرم هنرمندان
  
  // فیلدهای مالی
  balance         Float    @default(0)
  commissionRate  Float    @default(10.0) // 10% پیش‌فرض برای پلتفرم
  
  // فیلدهای مربوط به چرخه تایید تغییرات
  pendingEdits   Json?     // نگهداری تغییرات پیشنهادی هنرمند
  adminFeedback  String?   // بازخورد ادمین در صورت رد تغییرات یا رد محصول
  
  products    Product[]
  transactions Transaction[]
  specialties Specialty[] // ارتباط Many-to-Many با تخصص‌ها
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
  id              String         @id @default(cuid())
  title           String
  description     String
  imageUrl        String
  artistId        String
  artist          ArtistProfile  @relation(fields: [artistId], references: [id], onDelete: Cascade)
  
  // انبارداری و نوع محصول
  stockQuantity   Int            @default(1)
  isUnique        Boolean        @default(true) // محصول تک‌نسخه است یا قابل تولید مجدد
  
  // فیلدهای سئو تولید شده توسط هوش مصنوعی
  seoMetaTitle    String?
  seoMetaDesc     String?
  seoKeywords     String?
  
  status          ProductStatus  @default(PENDING) // نیازمند تایید ادمین کل
  adminFeedback   String?        // دلیل رد محصول توسط ادمین
  deletedAt       DateTime?      // پیاده‌سازی Soft Delete برای جلوگیری از خطای انسانی
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  specialties     Specialty[]    // ارتباط Many-to-Many با تخصص‌ها
  pricingTiers    PricingTier[]
  orderItems      OrderItem[]
  certificates    ProductCertificate[]
}

model Transaction {
  id          String         @id @default(cuid())
  artistId    String
  artist      ArtistProfile  @relation(fields: [artistId], references: [id], onDelete: Cascade)
  orderId     String?
  amount      Float
  type        TransactionType
  status      TransactionStatus @default(COMPLETED)
  description String?
  createdAt   DateTime       @default(now())
}

enum TransactionType {
  CREDIT  // واریز به حساب هنرمند بابت فروش
  DEBIT   // برداشت از حساب هنرمند بابت تسویه
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

model ProductCertificate {
  id          String   @id @default(cuid())
  hash        String   @unique // هش SHA-256 ترکیب شده با نمک (Salt)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id])
  orderItemId String   @unique // هر آیتم سفارش یک شناسنامه دارد
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  issuedAt    DateTime @default(now())
}

enum ProductStatus {
  PENDING   // در انتظار تایید ادمین
  APPROVED  // تایید شده و قابل نمایش
  REJECTED  // رد شده
  ARCHIVED  // بایگانی/حذف نرم توسط هنرمند
}

model PricingTier {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  tierType     String   // PRE_ORDER, STANDARD, EXPRESS
  title        String
  description  String
  price        Float
  deliveryTime String
  isAvailable  Boolean  @default(true)
}

model Order {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id])
  total      Float
  status     OrderStatus @default(PENDING)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  items      OrderItem[]
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String
  product       Product  @relation(fields: [productId], references: [id])
  pricingTierId String
  priceAtTime   Float
  quantity      Int      @default(1)
  certificate   ProductCertificate?
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model Specialty {
  id          String   @id @default(cuid())
  name        String   @unique
  isApproved  Boolean  @default(true)
  createdAt   DateTime @default(now())

  artists     ArtistProfile[]
  products    Product[]
}

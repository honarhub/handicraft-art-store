datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  phoneNumber   String?   @unique // اضافه شده برای ورود با پیامک در آینده
  password      String?   // برای ورود موقت با ایمیل و رمز عبور
  role          Role      @default(USER)
  mustChangePassword Boolean @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  artistProfile ArtistProfile?
  orders        Order[]
  certificates  ProductCertificate[] // مدارک مالکیت محصولات خریداری شده
  reviews       ProductReview[]
  questions     ProductQuestion[]
  createdReferrals ReferralCode[] @relation("CreatedReferrals")
  usedReferral     ReferralCode?  @relation("UsedReferral")
}

enum Role {
  USER
  ARTIST
  ADMIN
}

model VerificationCode {
  id        String   @id @default(cuid())
  target    String   // شماره موبایل یا ایمیل
  code      String   // کد ۵ رقمی
  type      String   // "PHONE_OTP" | "PASSWORD_RESET"
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([target, type])
}

model ReferralCode {
  id          String    @id @default(cuid())
  code        String    @unique
  creatorId   String?   // کاربری که کد را ایجاد کرده یا به او تخصیص یافته (هنرمند یا ادمین)
  creator     User?     @relation("CreatedReferrals", fields: [creatorId], references: [id], onDelete: SetNull)
  usedById    String?   @unique // کاربری که با این کد ثبت نام کرده است
  usedBy      User?     @relation("UsedReferral", fields: [usedById], references: [id], onDelete: SetNull)
  isUsed      Boolean   @default(false)
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([creatorId])
  @@index([code])
}

model ArtistProfile {
  id          String   @id @default(cuid())
  displayId   Int      @default(autoincrement()) @unique
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // اطلاعات برند و هویت هنری (سطح ۱ و ۲)
  brandName   String?  // نام برند یا استودیوی هنری
  province    String?  // استان
  city        String?  // شهر
  bio         String?
  portfolioUrl String?
  bannerUrl   String?  // تصویر بنر بالای فروشگاه/گالری هنرمند
  socialLinks Json?    // { instagram: "url", twitter: "url", telegram: "url", bale: "url" }
  
  // سطح احراز هویت (۰: ثبت‌نام، ۱: اطلاعات پایه و تخصص، ۲: رزومه و گالری، ۳: کارت ملی و حقوقی)
  verificationLevel Int @default(0)
  
  // مدارک هویتی و مالی (سطح ۳)
  nationalId        String?  // کد ملی
  nationalCardImage String?  // تصویر کارت ملی
  birthDate         String?  // تاریخ تولد (شمسی: YYYY/MM/DD)
  address           String?  // آدرس کارگاه یا محل سکونت
  postalCode        String?  // کد پستی
  shebaNumber       String?  // شماره شبا بانکی (بدون IR)
  
  isActive    Boolean  @default(true)
  isDeleted   Boolean  @default(false) // حذف نرم هنرمندان
  isApproved  Boolean  @default(false) // تایید ادمین برای ثبت‌نام جدید
  
  // درخواست حذف کامل پروفایل هنرمندی توسط هنرمند
  deletionRequested   Boolean   @default(false)
  deletionReason      String?
  deletionRequestedAt DateTime?
  
  // فیلدهای مالی
  balance         Float    @default(0)
  commissionRate  Float    @default(10.0) // 10% پیش‌فرض برای پلتفرم
  
  // فیلدهای مربوط به چرخه تایید تغییرات
  pendingEdits   Json?     // نگهداری تغییرات پیشنهادی هنرمند
  adminFeedback  String?   // بازخورد ادمین در صورت رد تغییرات یا رد محصول
  
  products    Product[]
  transactions Transaction[]
  specialties Specialty[] // ارتباط Many-to-Many با تخصص‌ها
  blogPosts   BlogPost[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
  id              String         @id @default(cuid())
  displayId       Int            @default(autoincrement()) @unique
  title           String
  description     String
  imageUrl        String
  mediaUrls       String[]       @default([]) // فایل‌های آپلودی بیشتر (عکس و ویدیو)
  artistId        String
  artist          ArtistProfile  @relation(fields: [artistId], references: [id], onDelete: Cascade)
  
  // انبارداری و نوع محصول
  stockQuantity      Int            @default(1)
  isUnique           Boolean        @default(true) // محصول تک‌نسخه است یا قابل تولید مجدد
  shippingMode       String         @default("ARTIST_DIRECT") // "ARTIST_DIRECT" | "HONARHUB_WAREHOUSE"
  isPreOrderEnabled  Boolean        @default(false)
  preOrderTiers      Json?          // تنظیمات بازه‌های پیش‌سفارش
  pendingEdits       Json?          // تغییرات پیشنهادی در انتظار تایید ادمین
  
  // فیلدهای سئو تولید شده توسط هوش مصنوعی
  seoMetaTitle    String?
  seoMetaDesc     String?
  seoKeywords     String?
  
  status          ProductStatus  @default(PENDING) // نیازمند تایید ادمین کل
  adminFeedback       String?        // دلیل رد محصول یا آخرین بازخورد ادمین
  adminFeedbackHistory Json?         // تاریخچه آخرین پیام‌ها و بازخوردهای ادمین
  adminFeedbackRead   Boolean        @default(false) // وضعیت مشاهده بازخورد توسط هنرمند
  deletedAt       DateTime?      // پیاده‌سازی Soft Delete برای جلوگیری از خطای انسانی
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  specialties     Specialty[]    // ارتباط Many-to-Many با تخصص‌ها
  pricingTiers    PricingTier[]
  orderItems      OrderItem[]
  certificates    ProductCertificate[]
  supportMessages SupportMessage[]
  stockNotifications StockNotification[]
  reviews         ProductReview[]
  questions       ProductQuestion[]
}

model Transaction {
  id          String         @id @default(cuid())
  artistId    String
  artist      ArtistProfile  @relation(fields: [artistId], references: [id], onDelete: Cascade)
  orderId     String?
  amount      Float
  type        TransactionType
  status      TransactionStatus @default(COMPLETED)
  description String?
  createdAt   DateTime       @default(now())
}

enum TransactionType {
  CREDIT  // واریز به حساب هنرمند بابت فروش
  DEBIT   // برداشت از حساب هنرمند بابت تسویه
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

model ProductCertificate {
  id          String   @id @default(cuid())
  hash        String   @unique // هش SHA-256 ترکیب شده با نمک (Salt)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id])
  orderItemId String   @unique // هر آیتم سفارش یک شناسنامه دارد
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  issuedAt    DateTime @default(now())
}

enum ProductStatus {
  PENDING   // در انتظار تایید ادمین
  APPROVED  // تایید شده و قابل نمایش
  REJECTED  // رد شده
  ARCHIVED  // بایگانی/حذف نرم توسط هنرمند
}

model PricingTier {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  tierType     String   // PRE_ORDER, STANDARD, EXPRESS
  title        String
  description  String
  price        Float
  deliveryTime String
  isAvailable  Boolean  @default(true)
}

model Order {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id])
  total      Float
  status     OrderStatus @default(PENDING)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  items      OrderItem[]
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String
  product       Product  @relation(fields: [productId], references: [id])
  pricingTierId String
  priceAtTime   Float
  quantity      Int      @default(1)
  certificate   ProductCertificate?
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model Specialty {
  id          String      @id @default(cuid())
  name        String      @unique
  isApproved  Boolean     @default(true)
  createdAt   DateTime    @default(now())

  parentId    String?
  parent      Specialty?  @relation("SpecialtyHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Specialty[] @relation("SpecialtyHierarchy")

  artists     ArtistProfile[]
  products    Product[]
  siteSettings SiteSettings[] // One to many for featured category
  blogPosts   BlogPost[]

  @@index([parentId])
}

model SupportMessage {
  id            String    @id @default(cuid())
  name          String
  contact       String    // شماره تماس یا ایمیل
  message       String
  attachmentUrl String?   // لینک فایل پیوست (پرایوت)
  ipAddress     String?   // برای جلوگیری از اسپم
  productId     String?
  product       Product?  @relation(fields: [productId], references: [id])
  status        SupportStatus @default(PENDING)
  createdAt     DateTime  @default(now())
}

enum SupportStatus {
  PENDING
  RESOLVED
}

model StockNotification {
  id          String   @id @default(cuid())
  contact     String   // شماره تماس یا ایمیل
  ipAddress   String?  // برای جلوگیری از اسپم
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  isNotified  Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model SiteSettings {
  id                       String     @id @default("default")
  featuredSpecialtyId       String?
  featuredSpecialty        Specialty? @relation(fields: [featuredSpecialtyId], references: [id])
  dynamicRows              Json       @default("[]")
  artistAiEnabled          Boolean    @default(true)

  // SMS & OTP (sms.ir) Settings
  isMobileOtpActive        Boolean    @default(true)
  smsProvider              String     @default("sms.ir")
  smsApiKey                String?
  smsTemplateId            String?
  smsOtpParamName          String     @default("Code")
  smsLineNumber            String?
  otpResendIntervalSeconds Int        @default(60)
  otpMaxPerHourPerPhone    Int        @default(5)
  otpMaxPerTenMinPerIp     Int        @default(10)
  otpLockoutMinutes        Int        @default(15)

  updatedAt                DateTime   @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model BlogPost {
  id              String         @id @default(cuid())
  slug            String         @unique
  title           String
  content         String         @db.Text
  excerpt         String?
  coverImage      String?
  tags            String[]       @default([])
  seoMeta         Json?    
  isPublished     Boolean        @default(true)
  publishedAt     DateTime       @default(now())
  
  specialtyId     String?
  specialty       Specialty?     @relation(fields: [specialtyId], references: [id], onDelete: SetNull)

  artistProfileId String?
  artistProfile   ArtistProfile? @relation(fields: [artistProfileId], references: [id], onDelete: SetNull)

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model ProductReview {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating     Int      // 1 to 5
  comment    String   @db.Text
  isBuyer    Boolean  @default(false)
  isApproved Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([productId])
  @@index([userId])
}

model ProductQuestion {
  id         String    @id @default(cuid())
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   String    @db.Text
  answer     String?   @db.Text
  answeredAt DateTime?
  isApproved Boolean   @default(true)
  createdAt  DateTime  @default(now())

  @@index([productId])
  @@index([userId])
}

model OtpRequestLog {
  id         String   @id @default(cuid())
  ip         String
  target     String   // شماره موبایل یا ایمیل
  type       String   // PHONE_OTP, REGISTER_OTP, PASSWORD_RESET, etc.
  status     String   // "SENT", "BLOCKED_COOLDOWN", "BLOCKED_PHONE_CAP", "BLOCKED_IP_FLOOD", "FAILED_GATEWAY", "DISABLED"
  reason     String?
  createdAt  DateTime @default(now())

  @@index([ip, createdAt])
  @@index([target, createdAt])
  @@index([status, createdAt])
}
